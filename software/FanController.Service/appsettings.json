{
  "Service": {
    "GrpcPort": 51515,
    "Logging": {
      "RollingInterval": "Day",
      "RetainedFileCountLimit": 30
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Grpc": "Warning",
        "Grpc.AspNetCore.Server.ServerCallHandler": "Fatal",
        "FanController.Service.Core": "Information",
        "FanController.Service.Core.FanControllerManager": "Information",
        "FanController.Service.Core.FanController": "Information",
        "FanController.Service.Core.HostSensorManager": "Information"
      }
    }
  }
}
