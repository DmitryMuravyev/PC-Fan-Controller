<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FanController.ViewModels"
             xmlns:lc="using:FanController.Controls"
             xmlns:cv="using:FanController.Converters"
             xmlns:lz="using:FanController.Localization"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="640"
             x:Class="FanController.Views.SensorView"
             x:DataType="vm:SensorViewModel">

    <UserControl.Styles>
        <!-- Drawn elements Enabled/Disabled styles -->
        <Style Selector="PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
        </Style>
        <Style Selector="PathIcon:disabled">
            <Setter Property="Foreground" Value="{DynamicResource TextControlForegroundDisabled}" />
        </Style>

        <!-- TextBlock Enabled/Disabled styles -->
        <Style Selector="TextBlock.deactivatable:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <!-- Border Enabled/Disabled styles -->
        <Style Selector="Border.deactivatable:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <!-- Applies ONLY to borders that also have the overcoolable class -->
        <Style Selector="Border.deactivatable.overcoolable">
            <Setter Property="Background" Value="{DynamicResource SystemBaseLowColor}" />
        </Style>

        <!-- Overcooled state — only for borders that opted in -->
        <Style Selector="Border.deactivatable.overcoolable.overcooled">
            <Setter Property="Background" Value="{DynamicResource OverallStateOvercool}" />
        </Style>

        <!-- Force DataGrid to select only rows, but not the individual cells -->
        <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Disable Flyout menu scroll arrows (for clean rendering on Linux) -->
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Top row with buttons -->
            <RowDefinition Height="Auto"/>  <!-- Separator row -->
            <RowDefinition Height="*"/>     <!-- Sensors table -->
            <RowDefinition Height="Auto"/>  <!-- Status Indicators row -->
        </Grid.RowDefinitions>

        <!-- Top row with main buttons -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <!-- Add / Remove sensor buttons -->
                <Button Content="{lz:Localize ButtonAddSensorCaption}"
                        Click="OnAddSensorClick"
                        Margin="10,10,5,5"
                        ToolTip.Tip="{lz:Localize ButtonAddSensorTip}" />
                <Button Content="{lz:Localize ButtonRemoveSensorCaption}"
                        Click="OnRemoveSensorClick"
                        IsEnabled="{Binding SelectedSensorsDeletable}"
                        Margin="5,10,5,5"
                        ToolTip.Tip="{lz:Localize ButtonRemoveSensorTip}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{lz:Localize ButtonResetSensorCaption}"
                        Click="OnResetStateClick"
                        IsEnabled="{Binding SelectionNotEmpty}"
                        Margin="5,10,5,5"
                        ToolTip.Tip="{lz:Localize ButtonResetSensorTip}" />
                <Button Content="{lz:Localize ButtonRescanSensorsCaption}"
                        Click="OnRescanSensorsClick"
                        Margin="5,10,10,5"
                        ToolTip.Tip="{lz:Localize ButtonRescanSensorsTip}" />
            </StackPanel>
        </Grid>

        <!-- Separator row -->
        <Separator Grid.Row="1" />

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Sensors}"
                  AutoGenerateColumns="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False"
                  IsReadOnly="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single"
                  SelectedItem="{Binding CurrentSensor, Mode=TwoWay}"
                  VerticalScrollBarVisibility="Auto"
                  RowHeight="40"
                  Margin="5">

            <DataGrid.Columns>

                <!-- Selection checkbox -->
                <DataGridTemplateColumn Width="70" MinWidth="70"
                                        CanUserResize="False"
                                        CanUserReorder="False">
                    <!-- Header with CheckBox -->
                    <DataGridTemplateColumn.Header>
                        <CheckBox Initialized="OnHeaderCheckBoxInitialized"
                                  Margin="0"
                                  Padding="0"
                                  HorizontalAlignment="Left" />
                    </DataGridTemplateColumn.Header>

                    <!-- Cell with CheckBox -->
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SensorItem">
                            <CheckBox IsChecked="{Binding Selected}"
                                      HorizontalAlignment="Left"
                                      Margin="12,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Sensor number -->
                <!--
                <DataGridTemplateColumn Header="#" Width="60" MinWidth="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center"
                                       Margin="12,0"
                                       Text="{Binding $parent[DataGridRow].Index}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                -->

                <!-- Configured Sensor Name -->
                <DataGridTextColumn Width="*"
                                    MinWidth="100"
                                    CanUserReorder="True"
                                    IsReadOnly="True"
                                    Binding="{Binding SensorConfig.Name, Mode=OneWay}" >
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{lz:Localize ColumnHeaderSensorNameCaption}"
                                   ToolTip.Tip="{lz:Localize ColumnHeaderSensorNameTip}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <!-- Status with color indicator -->
                <DataGridTemplateColumn Width="90"
                                        CanUserResize="False">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{lz:Localize ColumnHeaderSensorStatusCaption}"
                                   ToolTip.Tip="{lz:Localize ColumnHeaderSensorStatusTip}" />
                    </DataGridTemplateColumn.Header>

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SensorItem">
                            <Border CornerRadius="4"
                                    Padding="8,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{Binding Status,
                                    Converter={x:Static cv:SensorStatusToBackgroundConverter.Instance}, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10"
                                             Margin="0,0,6,0"
                                             Fill="{Binding Status,
                                             Converter={x:Static cv:SensorStatusToBackgroundConverter.Instance}, ConverterParameter=True, Mode=OneWay}" />
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{x:Static cv:EnumToLocalizedTextConverter.Instance}" Mode="OneWay">
                                                <Binding Path="Status" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Errors count -->
                <DataGridTextColumn Width="80"
                                    MinWidth="80"
                                    CanUserReorder="True"
                                    CanUserResize="False"
                                    IsReadOnly="True"
                                    Binding="{Binding SensorState.TotalErrorsCount, StringFormat='{}{0}', Mode=OneWay}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{lz:Localize ColumnHeaderSensorErrorsCaption}"
                                   ToolTip.Tip="{lz:Localize ColumnHeaderSensorErrorsTip}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <!-- Sensor type Indicator -->
                <DataGridTemplateColumn Width="80"
                                        MinWidth="80"
                                        CanUserResize="False">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{lz:Localize ColumnHeaderSensorTypeCaption}"
                                   ToolTip.Tip="{lz:Localize ColumnHeaderSensorTypeTip}" />
                    </DataGridTemplateColumn.Header>

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SensorItem">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Image Source="{Binding SensorConfig.IsActive,
                                       Converter={x:Static cv:SensorActivityToIconConverter.Instance}}"
                                       Width="32"
                                       Height="32"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,0,2,0"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                       ToolTip.Tip="{lz:Localize SensorIsActiveParameterTip}" />
                                <Image Source="{Binding SensorConfig.Type,
                                       Converter={x:Static cv:SensorTypeToIconConverter.Instance}}"
                                       Width="32"
                                       Height="32"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0"
                                       RenderOptions.BitmapInterpolationMode="HighQuality">
                                    <ToolTip.Tip>
                                        <MultiBinding Converter="{x:Static cv:EnumToLocalizedTextConverter.Instance}" Mode="OneWay">
                                            <Binding Path="SensorConfig.Type" />
                                            <Binding Source="Tip" />
                                        </MultiBinding>
                                    </ToolTip.Tip>
                                </Image>

                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Temperature indicator -->
                <DataGridTemplateColumn Width="140" MinWidth="100" CanUserReorder="True">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{lz:Localize ColumnHeaderSensorTemperatureCaption}"
                                   ToolTip.Tip="{lz:Localize ColumnHeaderSensorTemperatureTip}" />
                    </DataGridTemplateColumn.Header>

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SensorItem">
                            <Grid Margin="4,0"
                                  x:Name="TemperatureBarContainer">

                                <!-- Background track -->
                                <Border CornerRadius="3"
                                        Height="16"
                                        Background="{DynamicResource SystemBaseLowColor}"
                                        HorizontalAlignment="Stretch" />

                                <!-- Just the container for calculated Temperature percentage -->
                                <ContentControl x:Name="TemperaturePercentage" IsVisible="False">
                                    <ContentControl.Content>
                                        <MultiBinding Converter="{x:Static cv:TemperatureToPercentConverter.Instance}" Mode="OneWay">
                                            <Binding Path="SensorState.Temperature" />
                                        </MultiBinding>
                                    </ContentControl.Content>
                                </ContentControl>

                                <!-- Filled bar -->
                                <Border CornerRadius="3"
                                        Height="16"
                                        HorizontalAlignment="Left">    
                                    <Border.Background>
                                        <MultiBinding Converter="{x:Static cv:TemperatureToColorConverter.Instance}" Mode="OneWay">
                                            <Binding Path="SensorState.Temperature" />
                                            <Binding Path="SensorConfig.WarningThreshold" />
                                            <Binding Path="SensorConfig.AlarmThreshold" />
                                        </MultiBinding>
                                    </Border.Background>
                                    <Border.Width>
                                        <MultiBinding Converter="{x:Static cv:PercentBarWidthConverter.Instance}" Mode="OneWay">
                                            <Binding Path="Content" ElementName="TemperaturePercentage" />
                                            <Binding Path="Bounds.Width" ElementName="TemperatureBarContainer" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                                
                                <!-- Temperature text overlay -->
                                <TextBlock FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{x:Static cv:StringFormatConverter.Instance}">
                                            <Binding Path="SensorState.Temperature"/>
                                            <ReflectionBinding Path="[TemperatureParameterShortFormat]"
                                                               Source="{x:Static lz:LocalizationService.Instance}"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Fan Output -->
                <DataGridTemplateColumn Width="520"
                                        MinWidth="370"
                                        CanUserReorder="True">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{lz:Localize ColumnHeaderSensorOutputControlCaption}"
                                   ToolTip.Tip="{lz:Localize ColumnHeaderSensorOutputControlTip}" />
                    </DataGridTemplateColumn.Header>

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SensorItem">
                            <ItemsControl ItemsSource="{Binding FanOutputs}"
                                            HorizontalAlignment="Stretch">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- UniformGrid stretches and divides width equally among items -->
                                        <UniformGrid Rows="1"
                                                     Margin="4,0"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:FanOutput">
                                        <Grid x:Name="PowerBarContainer"
                                                Margin="3,0"
                                                IsEnabled="{Binding Dominant}"
                                                ToolTip.ShowOnDisabled="True">
                                            <ToolTip.Tip>
                                                <TextBlock Text="{Binding FanName}"/>
                                            </ToolTip.Tip>

                                            <!-- Background track -->
                                            <Border Classes="deactivatable overcoolable"
                                                    Classes.overcooled="{Binding Overcooled}"
                                                    CornerRadius="3"
                                                    Height="16"
                                                    HorizontalAlignment="Stretch" />

                                            <!-- Filled bar -->
                                            <Border Classes="deactivatable"
                                                    CornerRadius="3"
                                                    Height="16"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource SystemBaseMediumColor}">
                                                <Border.Width>
                                                    <MultiBinding Converter="{x:Static cv:PercentBarWidthConverter.Instance}"
                                                                    Mode="OneWay">
                                                        <Binding Path="Output"/>
                                                        <Binding Path="Bounds.Width"
                                                                    ElementName="PowerBarContainer"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>

                                            <!-- Percentage text overlay -->
                                            <TextBlock Classes="deactivatable"
                                                        Text="{Binding Output, Converter={x:Static cv:DoubleToPercentConverter.Instance}, Mode=OneWay}"
                                                        FontSize="11"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Sensor row menu -->
                <DataGridTemplateColumn Width="40"
                                        CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SensorItem">
                            <Button Classes="menuButton"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">

                                        <!-- Open Details window -->
                                        <MenuItem Header="{lz:Localize MenuDetailsCaption}"
                                                  Click="OnDetailsClick"/>

                                        <Separator />

                                        <!-- Reset State -->
                                        <MenuItem Header="{lz:Localize MenuResetSensorCaption}"
                                                  Click="OnResetStateClick"/>

                                        <Separator />

                                        <!-- Remove Sensor -->
                                        <MenuItem Header="{lz:Localize MenuRemoveSensorCaption}"
                                                  IsEnabled="{Binding SensorConfig.IsDeletable}"
                                                  Click="OnRemoveSensorClick"/>

                                    </MenuFlyout>
                                </Button.Flyout>

                                <!-- Three dots icon -->
                                <PathIcon Data="M12,16A2,2 0 0,1 14,18A2,2 0 0,1 12,20A2,2 0 0,1 10,18A2,2 0 0,1 12,16M12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12A2,2 0 0,1 12,10M12,4A2,2 0 0,1 14,6A2,2 0 0,1 12,8A2,2 0 0,1 10,6A2,2 0 0,1 12,4Z"
                                          Width="16" Height="16" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>

        <!-- Status Indicators row -->
        <Grid Grid.Row="3" VerticalAlignment="Bottom"
              IsVisible="{Binding HasCurrentSensor}"
              Margin="0,5,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>


            <Border Grid.Row="0" Grid.Column="0"
                    Margin="10,0,5,0"
                    CornerRadius="10">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource SystemBaseLowColor}" 
                                     Opacity="0.33"/>
                </Border.Background>

                <StackPanel Orientation="Vertical">
                    
                    <TextBlock Text="{lz:Localize SectionSensorPropertiesName}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,2"
                               Opacity="0.4"/>

                    <Grid Margin="0,0,0,5"
                          HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Sensor Serial Number -->
                        <lc:StatusLabel Grid.Row="0" Grid.Column="0"
                                        FontSize="11"
                                        Padding="20,0"
                                        Margin="0,4"
                                        Height="16"
                                        IsActive="True"
                                        Foreground="{DynamicResource GlobalInfo}"
                                        ToolTip.Tip="{lz:Localize SensorSerialNumberParameterTip}">
                            <lc:StatusLabel.Text>
                                <MultiBinding Converter="{x:Static cv:StringFormatConverter.Instance}"
                                              Mode="OneWay">
                                    <Binding Path="CurrentSensor?.ReadableSerialNumber" />
                                    <ReflectionBinding Path="[SensorSerialNumberParameterShortFormat]"
                                                       Source="{x:Static lz:LocalizationService.Instance}"/>
                                </MultiBinding>
                            </lc:StatusLabel.Text>
                        </lc:StatusLabel>

                        <!-- Warning Temperature -->
                        <lc:StatusLabel Grid.Row="1" Grid.Column="0"
                                        FontSize="11"
                                        Padding="20,0"
                                        Margin="0,4"
                                        Height="16"
                                        IsActive="True"
                                        Foreground="{DynamicResource GlobalInfo}"
                                        ToolTip.Tip="{lz:Localize SensorWarningTempParameterTip}">
                            <lc:StatusLabel.Text>
                                <MultiBinding Converter="{x:Static cv:StringFormatConverter.Instance}"
                                              Mode="OneWay">
                                    <Binding Path="CurrentSensor?.SensorConfig?.WarningThreshold" />
                                    <ReflectionBinding Path="[SensorWarningTempParameterShortFormat]"
                                                       Source="{x:Static lz:LocalizationService.Instance}"/>
                                </MultiBinding>
                            </lc:StatusLabel.Text>
                        </lc:StatusLabel>

                        <!-- Alarm Temperature -->
                        <lc:StatusLabel Grid.Row="2" Grid.Column="0"
                                        FontSize="11"
                                        Padding="20,0"
                                        Margin="0,4"
                                        Height="16"
                                        IsActive="True"
                                        Foreground="{DynamicResource GlobalInfo}"
                                        ToolTip.Tip="{lz:Localize SensorAlarmTempParameterTip}">
                            <lc:StatusLabel.Text>
                                <MultiBinding Converter="{x:Static cv:StringFormatConverter.Instance}"
                                              Mode="OneWay">
                                    <Binding Path="CurrentSensor?.SensorConfig?.AlarmThreshold" />
                                    <ReflectionBinding Path="[SensorAlarmTempParameterShortFormat]"
                                                       Source="{x:Static lz:LocalizationService.Instance}"/>
                                </MultiBinding>
                            </lc:StatusLabel.Text>
                        </lc:StatusLabel>


                        <!-- Is Sensor Visible on Display -->
                        <lc:StatusLabel Grid.Row="0" Grid.Column="1"
                                        Text="{lz:Localize SensorIsVisibleParameterShortName}"
                                        FontSize="11"
                                        Padding="20,0"
                                        Margin="0,4"
                                        Height="16"
                                        IsActive="{Binding CurrentSensor?.SensorConfig?.IsVisible,
                                        FallbackValue=False,
                                        TargetNullValue=False,
                                        Mode=OneWay}"
                                        Foreground="{DynamicResource GlobalInfo}"
                                        ToolTip.Tip="{lz:Localize SensorIsVisibleParameterTip}" />

                        <!-- Is Sensor Deletable -->
                        <lc:StatusLabel Grid.Row="1" Grid.Column="1"
                                        Text="{lz:Localize SensorIsDeletableParameterShortName}"
                                        FontSize="11"
                                        Padding="20,0"
                                        Margin="0,4"
                                        Height="16"
                                        IsActive="{Binding CurrentSensor?.SensorConfig?.IsDeletable,
                                        FallbackValue=False,
                                        TargetNullValue=False,
                                        Mode=OneWay}"
                                        Foreground="{DynamicResource GlobalInfo}"
                                        ToolTip.Tip="{lz:Localize SensorIsDeletableParameterTip}" />  

                        <!-- Is Sensor ignorable -->
                        <lc:StatusLabel Grid.Row="2" Grid.Column="1"
                                        Text="{lz:Localize SensorIsIgnorableParameterShortName}"
                                        FontSize="11"
                                        Padding="20,0"
                                        Margin="0,4"
                                        Height="16"
                                        IsActive="{Binding CurrentSensor?.SensorConfig?.IsIgnorable,
                                        FallbackValue=False,
                                        TargetNullValue=False,
                                        Mode=OneWay}"
                                        Foreground="{DynamicResource GlobalInfo}"
                                        ToolTip.Tip="{lz:Localize SensorIsIgnorableParameterTip}" /> 

                        <!-- Is Sensor saved to ROM -->
                        <!--
                        <lc:StatusLabel Grid.Row="2" Grid.Column="1"
                                        Text="{lz:Localize SensorIsPermanentParameterShortName}"
                                        FontSize="11"
                                        Padding="20,0"
                                        Margin="0,4"
                                        Height="16"
                                        IsActive="{Binding CurrentSensor?.SensorConfig?.IsPermanent,
                                        FallbackValue=False,
                                        TargetNullValue=False,
                                        Mode=OneWay}"
                                        Foreground="{DynamicResource GlobalInfo}"
                                        ToolTip.Tip="{lz:Localize SensorIsPermanentParameterTip}" />  
                        -->

                        <!-- Fan Lower Threshold Header -->
                        <lc:StatusLabel Grid.Row="0" Grid.Column="2"
                                        Text="{lz:Localize SensorLowThresholdsParameterShortName}"
                                        TextAlignment="Right"
                                        FontSize="11"
                                        Padding="20,0,0,0"
                                        Margin="0,4"
                                        Height="16"
                                        IsActive="True"
                                        Foreground="{DynamicResource GlobalInfo}"
                                        ToolTip.Tip="{lz:Localize SensorLowThresholdsParameterTip}" />  
 
                        <!-- Fan Upper Threshold Header -->
                        <lc:StatusLabel Grid.Row="1" Grid.Column="2"
                                        Text="{lz:Localize SensorHighThresholdsParameterShortName}"
                                        TextAlignment="Right"
                                        FontSize="11"
                                        Padding="20,0,0,0"
                                        Margin="0,4"
                                        Height="16"
                                        IsActive="True"
                                        Foreground="{DynamicResource GlobalInfo}"
                                        ToolTip.Tip="{lz:Localize SensorHighThresholdsParameterTip}" />  

                        <!-- Fan Impact Header -->
                        <lc:StatusLabel Grid.Row="2" Grid.Column="2"
                                        Text="{lz:Localize SensorFanImpactParameterShortName}"
                                        TextAlignment="Right"
                                        FontSize="11"
                                        Padding="20,0,0,0"
                                        Margin="0,4"
                                        Height="16"
                                        IsActive="True"
                                        Foreground="{DynamicResource GlobalInfo}"
                                        ToolTip.Tip="{lz:Localize SensorFanImpactParameterTip}" />  

                        <!-- Fan Low Temperature Thresholds Vector -->
                        <ItemsControl Grid.Row="0" Grid.Column="3"
                                        ItemsSource="{Binding CurrentSensor?.FanOutputs}"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,10,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Margin="5,0" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:FanOutput">
                                    <Grid Margin="3,0">
                                        <ToolTip.Tip>
                                            <TextBlock Text="{Binding FanName}"/>
                                        </ToolTip.Tip>

                                        <lc:StatusLabel FontSize="11"
                                                        Padding="10,0"
                                                        Height="16"
                                                        Width="50"
                                                        IsActive="True"
                                                        Foreground="{DynamicResource GlobalInfo}">
                                            <lc:StatusLabel.Text>
                                                <MultiBinding Converter="{x:Static cv:StringFormatConverter.Instance}"
                                                                Mode="OneWay">
                                                    <Binding Path="LowThreshold" />
                                                    <ReflectionBinding Path="[TemperatureParameterIntFormat]"
                                                                        Source="{x:Static lz:LocalizationService.Instance}"/>
                                                </MultiBinding>
                                            </lc:StatusLabel.Text>
                                        </lc:StatusLabel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Fan High Temperature Thresholds Vector -->
                        <ItemsControl Grid.Row="1" Grid.Column="3"
                                      ItemsSource="{Binding CurrentSensor?.FanOutputs}"
                                      HorizontalAlignment="Left"
                                      Margin="0,0,10,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Margin="5,0"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:FanOutput">
                                    <Grid Margin="3,0">
                                        <ToolTip.Tip>
                                            <TextBlock Text="{Binding FanName}"/>
                                        </ToolTip.Tip>

                                        <lc:StatusLabel FontSize="11"
                                                        Padding="10,0"
                                                        Height="16"
                                                        Width="50"
                                                        IsActive="True"
                                                        Foreground="{DynamicResource GlobalInfo}"> 
                                            <lc:StatusLabel.Text>
                                                <MultiBinding Converter="{x:Static cv:StringFormatConverter.Instance}"
                                                              Mode="OneWay">
                                                    <Binding Path="HighThreshold" />
                                                    <ReflectionBinding Path="[TemperatureParameterIntFormat]"
                                                                       Source="{x:Static lz:LocalizationService.Instance}"/>
                                                </MultiBinding>
                                            </lc:StatusLabel.Text>
                                        </lc:StatusLabel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Fan Impact Vector -->
                        <ItemsControl Grid.Row="2" Grid.Column="3"
                                      ItemsSource="{Binding CurrentSensor?.FanOutputs}"
                                      HorizontalAlignment="Left"
                                      Margin="0,0,10,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Margin="5,0"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:FanOutput">
                                    <Grid Margin="3,0">
                                        <ToolTip.Tip>
                                            <TextBlock Text="{Binding FanName}"/>
                                        </ToolTip.Tip>

                                        <lc:StatusLabel Padding="10,0"
                                                        Height="16"
                                                        Width="50"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource GlobalInfo}"
                                                        IsActive="true"
                                                        Text="{Binding Impact, Converter={x:Static cv:DoubleToPercentConverter.Instance}, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </Grid>

                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="1"
                    Margin="5,0,10,0"
                    CornerRadius="10">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource SystemBaseLowColor}" 
                                     Opacity="0.33"/>
                </Border.Background>

                <StackPanel Orientation="Vertical">
                    
                    <TextBlock Text="{lz:Localize SectionSensorStatusName}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,2"
                               Opacity="0.4"/>

                    <Grid Margin="0,0,0,5"
                          HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Sensor Temperature Warning -->
                        <lc:StatusLabel Grid.Row="0" Grid.Column="0"
                                        Padding="20,0"
                                        Margin="5,4"
                                        CornerRadius="8"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        Text="{lz:Localize SensorStatusTemperatureWarningShortName}"
                                        FontSize="11"
                                        IsActive="{Binding CurrentSensor?.SensorState?.StatusWarning,
                                        FallbackValue=False,
                                        TargetNullValue=False,
                                        Mode=OneWay}"
                                        Background="{DynamicResource StatusWarning}"
                                        ToolTip.Tip="{lz:Localize SensorStatusTemperatureWarningTip}" />

                        <!-- Sensor Temperature Alarm -->
                        <lc:StatusLabel Grid.Row="1" Grid.Column="0"
                                        Padding="20,0"
                                        Margin="5,4"
                                        CornerRadius="8"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        Text="{lz:Localize SensorStatusTemperatureAlarmShortName}"
                                        FontSize="11"
                                        IsActive="{Binding CurrentSensor?.SensorState?.StatusAlarm,
                                        FallbackValue=False,
                                        TargetNullValue=False,
                                        Mode=OneWay}"
                                        Background="{DynamicResource StatusError}"
                                        ToolTip.Tip="{lz:Localize SensorStatusTemperatureAlarmTip}" />

                        <!-- Sensor Error -->
                        <lc:StatusLabel Grid.Row="2" Grid.Column="0"
                                        Padding="20,0"
                                        Margin="5,4"
                                        CornerRadius="8"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        Text="{lz:Localize SensorStatusHardwareErrorShortName}"
                                        FontSize="11"
                                        IsActive="{Binding CurrentSensor?.SensorState?.StatusError,
                                        FallbackValue=False,
                                        TargetNullValue=False,
                                        Mode=OneWay}"
                                        Background="{DynamicResource StatusError}"
                                        ToolTip.Tip="{lz:Localize SensorStatusHardwareErrorTip}" />

                        <!-- Sensor Valid -->
                        <lc:StatusLabel Grid.Row="0" Grid.Column="1"
                                        Padding="20,0"
                                        Margin="5,4"
                                        CornerRadius="8"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        Text="{lz:Localize SensorStatusValidShortName}"
                                        FontSize="11"
                                        IsActive="{Binding CurrentSensor?.SensorState?.StatusValid,
                                        FallbackValue=False,
                                        TargetNullValue=False,
                                        Mode=OneWay}"
                                        Background="{DynamicResource StatusNormal}"
                                        ToolTip.Tip="{lz:Localize SensorStatusValidTip}" />


                        <!-- Sensor Not Configured -->
                        <lc:StatusLabel Grid.Row="1" Grid.Column="1"
                                        Padding="20,0"
                                        Margin="5,4"
                                        CornerRadius="8"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        Text="{lz:Localize SensorStatusNotConfiguredShortName}"
                                        FontSize="11"
                                        IsActive="{Binding !CurrentSensor?.SensorState?.StatusConfigured,
                                        FallbackValue=False,
                                        TargetNullValue=False,
                                        Mode=OneWay}"
                                        Background="{DynamicResource StatusWarning}"
                                        ToolTip.Tip="{lz:Localize SensorStatusNotConfiguredTip}" />

                        <!-- Sensor Disconnected -->
                        <lc:StatusLabel Grid.Row="2" Grid.Column="1"
                                        Padding="20,0"
                                        Margin="5,4"
                                        CornerRadius="8"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        Text="{lz:Localize SensorStatusDisconnectedShortName}"
                                        FontSize="11"
                                        IsActive="{Binding !CurrentSensor?.SensorState?.StatusConnected,
                                        FallbackValue=False,
                                        TargetNullValue=False,
                                        Mode=OneWay}"
                                        Background="{DynamicResource StatusError}"
                                        ToolTip.Tip="{lz:Localize SensorStatusDisconnectedTip}" />

                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
